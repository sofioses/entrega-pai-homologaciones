    {
      "parameters": {
        "jsCode": "const b = $json.body || {};\nconst system = [\n  'Sos un analista senior de seguridad de la informacion del equipo PAI (Proteccion de Activos Informaticos) de Banco Comafi, entidad regulada por el BCRA.',\n  'Evalua el riesgo de una solicitud de homologacion de un sistema/activo IT.',\n  'Analiza Confidencialidad, Integridad y Disponibilidad (CIA) y asigna un puntaje de 1 (bajo) a 5 (critico) a cada una.',\n  'Determina un nivel de riesgo global (Critico, Alto, Medio o Bajo) y lista los controles de seguridad requeridos.',\n  'Responde EXCLUSIVAMENTE con un objeto JSON valido, sin texto adicional ni markdown, con esta forma exacta:',\n  '{\"confidencialidad\": n, \"integridad\": n, \"disponibilidad\": n, \"nivel_riesgo\": \"Critico|Alto|Medio|Bajo\", \"controles\": [\"...\"], \"resumen\": \"...\"}'\n].join(' ');\nconst userPrompt = 'Solicitud de homologacion a evaluar:\\n' + JSON.stringify(b, null, 2);\nreturn [{ json: { systemPrompt: system, userPrompt } }];"
      },
      "id": "node-prep-prompt",
      "name": "Preparar Prompt IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'claude-haiku-4-5-20251001', max_tokens: 700, system: $json.systemPrompt, messages: [ { role: 'user', content: $json.userPrompt } ] } }}",
        "options": {}
      },
      "id": "node-claude",
      "name": "Claude - Evaluación de Riesgo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = ($json.content && $json.content[0] && $json.content[0].text) ? $json.content[0].text : '';\nconst clean = raw.replace(/```json/g, '').replace(/```/g, '').trim();\nlet data;\ntry { data = JSON.parse(clean); } catch (e) { throw new Error('La IA no devolvio JSON valido: ' + e.message + ' | Respuesta: ' + raw); }\nconst controles = Array.isArray(data.controles) ? data.controles.join('; ') : String(data.controles || '');\nconst resumen_full = (data.resumen || '') + '\\n\\nControles requeridos: ' + controles;\nreturn [{ json: { confidencialidad: data.confidencialidad, integridad: data.integridad, disponibilidad: data.disponibilidad, nivel_riesgo: data.nivel_riesgo, controles, resumen: data.resumen, resumen_full } }];"
      },
      "id": "node-parse",
      "name": "Parse - Evaluación IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [820, 200]
    },
